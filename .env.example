# VulnTriage configuration. Copy to .env and edit. Never commit .env.
# Every setting is optional; defaults are shown commented out.

# --- storage ---------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/vulntriage.db
# DATABASE_URL=postgresql+psycopg://vulntriage:CHANGE_ME@db:5432/vulntriage
# DATA_DIR=./data
# REPORTS_DIR=./reports
# OFFLINE=false

# --- scanning --------------------------------------------------------------
# DOCKER_HOST=unix:///var/run/docker.sock
# TRIVY_BIN=trivy
# ENABLE_GRYPE=false
# SCAN_TIMEOUT_SECONDS=900
# TRIVY_EXTRA_ARGS=
# Comma-separated glob patterns of image refs to skip:
# EXCLUDE_IMAGES=vulntriage*,docker-socket-proxy*
# Hosts (OS packages via `trivy rootfs`) and directories (lockfiles via `trivy fs`):
# HOST_SCAN_TARGETS=myhost=/host
# FS_SCAN_TARGETS=myapp=/srv/myapp
